# ============================================================
# EVERBLOOM Catalogues — variables d'environnement
# Copier ce fichier en `.env.local` et remplir les valeurs.
# ============================================================

# --- Accès opérateur (toi) ---
# Mot de passe de connexion à l'interface
ADMIN_PASSWORD=change-moi
# Secret de signature du cookie de session (32+ caractères aléatoires)
ADMIN_SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# --- Base de données Neon Postgres ---
# Créer un projet gratuit sur https://neon.tech puis coller l'URL de connexion
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Cloudinary (photos produits) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dwznpqq1s
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cron de nettoyage (photos 7 jours + crédits expirés) ---
CRON_SECRET=change-moi-aussi

# --- Puppeteer ---
# En local, ne pas télécharger Chromium si un binaire existe déjà :
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
