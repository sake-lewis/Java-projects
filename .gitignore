# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Fichiers de cles / secrets locaux (jamais versionnes)
# Couvre "cle chariow.md", "cle-chariow.txt", "cles_secrets.md",
# "Cle cron.txt", "cle-cron.md", etc.
[Cc]le*chariow*
[Cc]les*chariow*
[Cc]le*cron*
[Cc]les*cron*
*.secrets.*
secrets.local.*

# Rendus de test locaux du template PDF (scripts/render-master-test.mjs)
/public/dev-master-*.html

# Notes de session locales (contiennent des infos perso)
EVERBLOOM_contexte_reprise.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
